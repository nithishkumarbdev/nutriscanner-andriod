<?xml version="1.0" encoding="utf-8"?>
<!-- Default platform trust only. No cleartext traffic; ML Kit text recognition
     runs fully on-device and needs no network config of its own. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
